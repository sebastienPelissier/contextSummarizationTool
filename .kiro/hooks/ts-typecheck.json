{
  "version": "v1",
  "hooks": [
    {
      "name": "TypeScript typecheck on save",
      "trigger": "PostFileSave",
      "description": "Checks TypeScript syntax on every src/*.ts file save",
      "matcher": "src/.*\\.ts$",
      "action": {
        "type": "command",
        "command": "cd /home/framework/Projects/kiro-challenge/mcp-context-manager && npx tsc --noEmit 2>&1 | head -20"
      }
    }
  ]
}